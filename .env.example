# Ascendium One — environment
# Copy to .env for local development.

# Database: SQLite for zero-config dev. Switch to PostgreSQL by setting:
#   DATABASE_URL="postgresql://ascendium:ascendium@localhost:5432/ascendium_one?schema=public"
DATABASE_URL="file:./dev.db"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="dev-only-secret-change-me-0123456789abcdef"

# AI provider (optional). When unset, Ascendium Intelligence uses the built-in
# local retrieval engine. When set, the provider abstraction can route to:
#   AI_PROVIDER=openai   AI_API_KEY=...  AI_MODEL=gpt-4o-mini
#   AI_PROVIDER=anthropic AI_API_KEY=... AI_MODEL=claude-sonnet-4-20250514
AI_PROVIDER="local"
AI_API_KEY=""
AI_MODEL=""

# Demo-data watermark — every seeded record is labelled with this prefix.
DEMO_LABEL="[DEMO]"
